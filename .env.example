# Copy this file to .env for optional local configuration. Fake mode is the default.
# Online mode makes real paid requests. Set the key only in the server environment.
WORKBENCH_MODE=fake
API_PORT=2027
WEB_PORT=2026
DEEPSEEK_API_KEY=
# Optional read-only GitHub token used only for api.github.com metadata/ref lookups to avoid anonymous rate limits.
# It is never sent to codeload.github.com and must remain server-side.
GITHUB_TOKEN=
