{
  "name": "pi-agent-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.21.0", "npm": "11.9.0" },
  "packageManager": "npm@11.9.0",
  "workspaces": ["apps/server", "apps/worker", "apps/web", "packages/protocol", "packages/storage", "packages/agent-runtime", "packages/workbench", "packages/tools", "packages/reporting", "spikes/pi-sdk"],
  "scripts": {
    "check:toolchain": "node -e \"if(process.versions.node !== '24.21.0' || !process.env.npm_config_user_agent?.startsWith('npm/11.9.0 ')) throw new Error('Use Node.js 24.21.0 and npm 11.9.0')\"",
    "precheck": "npm run check:toolchain",
    "pretest": "npm run check:toolchain",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:v02",
    "test:v02": "tsx --test tests/v02/*.test.ts",
    "spike": "npm run start --workspace pi-sdk-spike",
    "demo:offline": "npm run demo --workspace @pi-workbench/reporting",
    "dev": "node --env-file-if-exists=.env apps/server/dev.mjs",
    "build": "npm run build --workspace @pi-workbench/web"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
